# Reproduces staticwebapp.config.json's globalHeaders. The CSP is the one this
# project already tuned for mermaid (style-src allows 'unsafe-inline' because
# mermaid sets inline styles on the SVG it generates; script-src stays strict).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://stroadmapprogress.blob.core.windows.net https://*.googleusercontent.com; font-src 'self'; connect-src 'self' https://stroadmapprogress.blob.core.windows.net; frame-src 'self' https://stroadmapprogress.blob.core.windows.net https://view.officeapps.live.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/assets/*
  Cache-Control: public, max-age=31536000, immutable
