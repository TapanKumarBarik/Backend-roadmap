# Reproduces staticwebapp.config.json's globalHeaders, plus:
#  - style-src 'unsafe-inline' for mermaid (it sets inline styles on its SVG)
#  - static.cloudflareinsights.com / cloudflareinsights.com for Cloudflare Web
#    Analytics (auto-injected by the proxied zone; cookie-less, privacy-first)
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://stroadmapprogress.blob.core.windows.net https://*.googleusercontent.com; font-src 'self'; connect-src 'self' https://stroadmapprogress.blob.core.windows.net https://cloudflareinsights.com; frame-src 'self' https://stroadmapprogress.blob.core.windows.net https://view.officeapps.live.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/assets/*
  Cache-Control: public, max-age=31536000, immutable
