{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types", "node"],
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["./**/*", "../functions/**/*"]
}
