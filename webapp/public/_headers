# Security headers for every response, plus:
#  - style-src 'unsafe-inline' for mermaid (it sets inline styles on its SVG)
#  - static.cloudflareinsights.com / cloudflareinsights.com for Cloudflare Web
#    Analytics (auto-injected by the proxied zone; cookie-less, privacy-first)
#  - i.ytimg.com (video thumbnails) and www.youtube-nocookie.com (the player,
#    which only loads once a reader presses play) for the videos in modules
#  - script-src 'wasm-unsafe-eval' for the Python and SQL runners of the practice screens (public/runner/): Pyodide is CPython, and sql.js is SQLite,
#    compiled to WebAssembly, and a browser will not compile WebAssembly under this policy without it. It allows compiling
#    WebAssembly only, not eval() or new Function(); the runner is served from this site, never from another.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://stroadmapprogress.blob.core.windows.net https://*.googleusercontent.com https://i.ytimg.com; font-src 'self'; connect-src 'self' https://stroadmapprogress.blob.core.windows.net https://cloudflareinsights.com; frame-src 'self' https://stroadmapprogress.blob.core.windows.net https://view.officeapps.live.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Pyodide and sql.js (the SQL engine, SQLite as WebAssembly) live in folders named for their version (see public/runner/README.txt), so their files never
# change under one address.
/runner/pyodide-314.0.7/*
  Cache-Control: public, max-age=31536000, immutable

/runner/sqljs-1.15.2/*
  Cache-Control: public, max-age=31536000, immutable

# The app's shell, kept as a file for the pages the server draws when they are asked for (api/pages/blogPages.js). It is a
# plain copy of the site's page, not a page of its own.
/app-shell
  X-Robots-Tag: noindex

# Every module is also served as its raw markdown (the app fetches it). It is the
# same text as the module's page, so keep it out of search results and let the
# page, which is the one with a title, a description and the site around it, rank.
/*.md
  X-Robots-Tag: noindex
