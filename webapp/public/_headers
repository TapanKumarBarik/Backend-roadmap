# Security headers for every response, plus:
#  - style-src 'unsafe-inline' for mermaid (it sets inline styles on its SVG)
#  - static.cloudflareinsights.com / cloudflareinsights.com for Cloudflare Web
#    Analytics (auto-injected by the proxied zone; cookie-less, privacy-first)
#  - i.ytimg.com (video thumbnails) and www.youtube-nocookie.com (the player,
#    which only loads once a reader presses play) for the videos in modules
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://stroadmapprogress.blob.core.windows.net https://*.googleusercontent.com https://i.ytimg.com; font-src 'self'; connect-src 'self' https://stroadmapprogress.blob.core.windows.net https://cloudflareinsights.com; frame-src 'self' https://stroadmapprogress.blob.core.windows.net https://view.officeapps.live.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Every module is also served as its raw markdown (the app fetches it). It is the
# same text as the module's page, so keep it out of search results and let the
# page, which is the one with a title, a description and the site around it, rank.
/*.md
  X-Robots-Tag: noindex
