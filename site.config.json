              "04-autoencoders-vaes-gans-and-diffusion",
              "05-graph-neural-networks-and-vision-transformers",
              "06-neural-network-performance-and-deployment"
            ]
          }
        ]
      },
      "genai": {
        "label": "GenAI Engineering",
        "short": "GenAI",
        "blurb": "Tokens, transformers and GPUs, then the OpenAI, Anthropic and Gemini APIs, embeddings and vector databases. RAG, agents and serving come next.",
        "groups": [
          {
            "label": "How models work",
            "tracks": [
