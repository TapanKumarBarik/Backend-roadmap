{
  "site": {
    "name": "Backend Roadmap",
    "url": "https://backendroadmap.com",
    "license": "MIT",
    "title": "Backend Roadmap — Backend Engineering, System Design & GenAI Curriculum",
    "description": "Backend Roadmap is a free, hands-on curriculum for backend engineering, system design, Linux, low-level design and GenAI, with progress tracking, notes and discussion.",
    "logo": "/icon-512.png",
    "socialImage": "/og-image.png"
  },
  "shareImage": {
    "dir": "og",
    "width": 1200,
    "height": 630,
    "colors": {
      "background": "#0e1116",
      "text": "#e7eaee",
      "muted": "#9aa2ae",
      "accent": "#e9a053",
      "onAccent": "#16181c",
      "logoDot": "#b25a08"
    }
  },
  "youtube": {
    "channel": "https://www.youtube.com/@tapankumarbarik9454"
  },
  "seo": {
    "indexNowKey": "047af5f1b34b705c9ba48a5469d54a5d",
    "indexNowEndpoint": "https://api.indexnow.org/indexnow"
  },
  "developer": {
    "name": "Tapan Kumar Barik",
    "shortName": "Tapan",
    "email": "tapankumarbarik7@gmail.com",
    "linkedin": "https://www.linkedin.com/in/tapan-barik-7b896a171/",
    "github": "https://github.com/TapanKumarBarik"
  },
  "repo": {
    "owner": "TapanKumarBarik",
    "name": "Backend-roadmap",
    "branch": "main"
  },
  "content": {
    "dir": "content",
    "curricula": ["backend", "system-design", "learn", "genai", "lld"],
    "placeholderMarker": "has not been written yet",
    "placeholderScanLines": 25,
    "wordsPerMinute": 210,
    "ignoredFiles": ["STATUS.md"],
    "images": {
      "maxBytes": 204800,
      "extensions": [".svg", ".png", ".jpg", ".jpeg", ".webp", ".gif"]
    }
  },
  "storage": {
    "lastFile": "docs.lastFile",
    "activePath": "docs.activePath",
    "seenLanding": "docs.seenLanding",
    "theme": "docs.theme",
    "sidebarCollapsed": "docs.sidebarCollapsed",
    "sidebarWidth": "docs.sidebarW",
    "rightRailCollapsed": "docs.rightRailCollapsed",
    "readingPositions": "docs.readingPositions",
    "selfCheck": "docs.selfCheck",
    "activityLastSeen": "docs.activityLastSeen",
    "feedLastSeen": "docs.feedLastSeen",
    "questionsLastSeen": "docs.questionsLastSeen",
    "languagePreference": "docLangPref",
    "studioDraft": "docs.studioDraft.",
    "dismissedNotices": "docs.dismissedNotices",
    "readingPrefs": "docs.readingPrefs"
  },
  "assistant": {
    "maxInputChars": 12000,
    "burstPerMinute": 6,
    "dailyLimit": 30,
    "workersAiModel": "@cf/meta/llama-3.1-8b-instruct",
    "anthropicModel": "claude-haiku-5-5"
  },
  "studio": {
    "autosaveWaitMs": 1200,
    "autosaveRetryMs": [2000, 5000, 15000, 30000],
    "recoveryCopyWaitMs": 400,
    "statsWaitMs": 300
  },
  "uploads": {
    "account": "stroadmapprogress",
    "containers": { "feed": "feed-uploads", "images": "images", "backups": "backups" }
  },
  "budgets": {
    "initialJsKb": 130,
    "initialCssKb": 26,
    "screensKb": { "StudioView": 240, "WorkspaceView": 210, "AdminDashboard": 16, "BlogsView": 12, "PostView": 14 }
  },
  "screenshots": {
    "dir": "screenshots",
    "defaultBase": "http://localhost:4180",
    "browserChannel": "msedge",
    "variants": [
      { "suffix": "desktop", "width": 1440, "height": 900 },
      { "suffix": "mobile", "width": 390, "height": 844 },
      { "suffix": "dark", "width": 1440, "height": 900, "colorScheme": "dark" }
    ],
    "pages": [
      { "name": "landing", "path": "/", "height": 2500, "mobileHeight": 3700 },
      { "name": "dashboard", "path": "/", "seenLanding": true },
      { "name": "module", "path": "/genai/05-gpus-and-genai-hardware/05-calculating-a-models-memory-requirements/" },
      { "name": "module-mermaid", "path": "/learn/01-linux/09-bash-scripting/" },
      { "name": "curriculum-overview", "path": "/genai/" },
      { "name": "unwritten-module", "path": "/genai/09-retrieval-augmented-generation/00-why-rag-exists/" },
      { "name": "lecture-video", "path": "/system-design/01-core-fundamentals/01-what-is-system-design/" },
      { "name": "videos", "path": "/#__videos", "height": 1400 },
      { "name": "explore", "path": "/#__explore" },
      { "name": "community", "path": "/#__community" }
    ]
  }
}
