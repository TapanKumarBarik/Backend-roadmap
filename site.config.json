    "areas": {
      "backend": {
        "label": "Backend Engineering",
        "short": "Backend",
        "blurb": "HTTP and APIs, authentication, databases, caching, queues, observability and distributed systems, ending in system-design interview practice.",
        "groups": [
          {
            "label": "The request path",
            "tracks": [
              "01-request-response-fundamentals",
              "02-api-layer-and-request-handling",
              "03-authentication-and-authorization"
            ]
          },
          {
            "label": "Data and speed",
            "tracks": [
              "04-databases-and-data-layer",
              "05-caching-and-performance",
              "07-search-with-elasticsearch"
            ]
          },
          {
            "label": "Background work and scale",
            "tracks": [
              "06-background-processing-and-realtime",
              "10-distributed-systems-patterns",
              "11-advanced-api-paradigms",
              "16-grpc-deep-dive",
              "17-kafka-and-streaming"
            ]
          },
          {
            "label": "Running it well",
            "tracks": [
              "08-observability-and-operational-readiness",
              "09-security-deep-dive",
              "12-testing-and-code-quality",
              "13-devops-for-backend-engineers"
            ]
          },
          {
            "label": "Design and products",
            "tracks": [
              "14-system-design-interview-practice",
              "15-multi-tenancy-and-saas-architecture"
            ]
          }
        ]
      },
      "system-design": {
        "label": "System Design Interview Prep",
        "short": "System design",
        "blurb": "Short lectures on requirements, scaling, latency, availability, CAP and consistency. Each has a video on YouTube and the written version beside it.",
        "groups": []
      },
      "ml": {
        "label": "Machine Learning",
        "short": "Machine Learning",
        "blurb": "NumPy, Pandas, Polars and EDA, math foundations, supervised and ensemble models, feature stores, unsupervised learning, time series, RecSys, RL and MLOps.",
        "groups": [
          {
            "label": "Data stack, EDA and math",
            "tracks": [
              "00-python-data-stack-and-eda",
              "01-ml-foundations-and-evaluation",
              "02-math-for-machine-learning"
            ]
          },
          {
            "label": "Classical supervised",
            "tracks": [
              "03-linear-models-and-svm",
              "04-decision-trees-and-gradient-boosting"
            ]
          },
          {
            "label": "Data and applied ML",
            "tracks": [
              "05-feature-engineering-and-feature-stores",
              "06-unsupervised-learning-and-anomaly-detection",
              "07-time-series-forecasting",
              "08-recommender-systems-and-ranking"
