          },
          {
            "label": "RL and production MLOps",
            "tracks": [
              "09-reinforcement-learning-and-bandits",
              "10-mlops-serving-drift-and-experimentation"
            ]
          }
        ]
      },
      "neural-networks": {
        "label": "Neural Networks",
        "short": "Neural Networks",
        "blurb": "Perceptrons and backpropagation from scratch, PyTorch training and optimization, CNNs, RNNs, autoencoders, VAEs, GANs, diffusion models, GNNs and deployment.",
        "groups": [
          {
            "label": "Core theory and PyTorch",
            "tracks": [
              "00-perceptrons-mlps-and-backpropagation",
              "01-optimization-regularization-and-pytorch"
            ]
          },
          {
            "label": "Vision and sequences",
            "tracks": [
              "02-convolutional-neural-networks-and-vision",
              "03-recurrent-networks-and-sequence-models"
            ]
          },
          {
            "label": "Generative, graphs and serving",
