  "runner": {
    "_about": "Which examples in a lesson get a Run button (webapp/src/lib/practice/runnable.js): a block in one of these languages that imports only these modules, all of which the Python of the browser runner (Pyodide) has. A package from outside the standard library is not there, so an example that needs one has no button rather than one that fails.",
    "languages": ["python", "py"],
    "modules": "__future__ abc argparse array ast base64 binascii bisect calendar cmath collections colorsys contextlib copy csv dataclasses datetime decimal difflib enum fractions functools gc gzip hashlib heapq hmac html inspect io itertools json keyword logging math numbers operator os pathlib pprint queue random re secrets shlex statistics string struct sys textwrap time timeit traceback types typing unicodedata unittest urllib uuid warnings weakref zlib"
  },
  "progressKeys": {
    "_about": "How a piece of practice is saved in a reader's progress, next to the modules: a coding problem solved is `<code><slug>`, a daily drill finished is `<drill><day>`. They are stored in readers' progress (browser and server), so they never change.",
    "code": "practice/code/",
    "drill": "practice/drill/"
  },
