{
  "name": "backend-roadmap",
  "private": true,
  "type": "module",
  "description": "Backend Roadmap — curriculum content, the React app (webapp/) and its API (api/, on Cloudflare Pages Functions)",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "webapp"
  ],
  "scripts": {
    "dev": "npm run dev --workspace webapp -- --port 4173 --strictPort",
    "build": "npm run build --workspace webapp && npm run index && node scripts/build/copy-content.mjs && node scripts/build/gen-share-images.mjs && node scripts/build/prerender.mjs",
    "preview": "npm exec --workspace webapp -- vite preview --outDir ../dist --port 4180 --strictPort",
    "api": "wrangler pages dev --port 8788",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:new": "wrangler d1 migrations create DB",
    "index": "node scripts/build/gen-docs-index.mjs && node scripts/build/gen-search-index.mjs && node scripts/build/gen-site-stats.mjs && node scripts/build/gen-videos.mjs",
    "test": "node --test \"webapp/src/**/*.test.js\" \"scripts/**/*.test.mjs\" \"api/tests/*.test.js\"",
    "test:e2e": "node --test \"tests/e2e/*.e2e.mjs\"",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p api && tsc -p scripts && tsc -p webapp",
    "check": "node scripts/check/check-admin-guards.mjs && node scripts/check/check-paths.mjs && node scripts/check/check-images.mjs && node scripts/check/check-videos.mjs && node scripts/check/check-overviews.mjs && node scripts/check/check-practice.mjs",
    "check:paths": "node scripts/check/check-paths.mjs",
    "check:images": "node scripts/check/check-images.mjs",
    "check:videos": "node scripts/check/check-videos.mjs",
    "check:overviews": "node scripts/check/check-overviews.mjs",
    "practice:build": "node scripts/build/gen-practice.mjs",
    "check:practice": "node scripts/check/check-practice.mjs",
    "check:bundle": "node scripts/check/check-bundle-size.mjs",
    "check:urls": "node scripts/check/check-urls.mjs",
    "check:urls:live": "node scripts/maintain/check-urls-live.mjs",
    "urls:register": "node scripts/maintain/register-urls.mjs",
    "videos:sync": "node scripts/maintain/sync-videos.mjs",
    "videos:links": "node scripts/maintain/video-links.mjs",
    "check:diagrams": "node scripts/check/mermaid.mjs",
    "shots": "node scripts/dev/screenshots.mjs",
    "shots:live": "node scripts/dev/screenshots.mjs --live"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.2",
    "@eslint/js": "^9.39.5",
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.1",
    "satori": "^0.63.2",
    "typescript": "^7.0.2",
    "wrangler": "4.145.0"
  }
}
