# Local working notes, not curriculum content.
learn/CURRICULUM-BUILD-STATUS.md
NEW-TOPICS-STATUS.md
lld/STATUS.md

# Dependencies and caches.
node_modules/
__pycache__/

# Claude Code's own local permission/session state -- machine-specific, not
# project config, and it drifted in here once already (an unrelated project's
# tool-permission allowlist, added inside an otherwise-unrelated content commit).
.claude/

# The whole built site — `npm run build` assembles it, and it is the only thing
# ever deployed. Nothing generated is written anywhere else in the repo,
# including docs-index.json and search-index.json (tracking those once meant a
# 5.9MB file in every clone and a diff on nearly every content commit).
/dist/

# Local secrets and wrangler state. Never commit; never let them into dist/.
.dev.vars*
!.dev.vars.example
.env*
.ENV
!.env.example
.wrangler
